# Copy to .env and fill in what you use. Everything is optional: with nothing set,
# the app runs fully offline on a synthetic match, with template explanations.

# Default feed. synthetic = data_gen/synthetic_match.py (no download).
MATCH_SOURCE=synthetic
MATCH_SEED=7
# MATCH_DIR=data/match_007
# MATCH_HALF_MINUTES=45

# Optional. Selecting these does not change the default.
# proto: the full 2-1 match around the prototype's three goals (data/match_proto)
# MATCH_SOURCE=proto
# MATCH_SOURCE=vision
# VISION_VIDEO=              # local clip; the API runs YOLO only when this is set
# VISION_SECONDS=8
# VISION_CALIBRATION=        # optional four-point JSON, see vision/homography.py
# VISION_DEVICE=cpu
# MATCH_SOURCE=live
# LIVE_FEED_PROVIDER=        # the licensed provider's name (shown in messages only)
# LIVE_FEED_API_KEY=
# LIVE_FEED_MATCH_ID=

# Microsoft Foundry / Azure OpenAI (hero stack)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=explainer
AZURE_OPENAI_API_VERSION=2024-10-21
# GAME_EXPLAIN_DEPLOYMENT=gpt-4.1-mini   # moment-by-moment analyst (falls back to AZURE_OPENAI_DEPLOYMENT)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# AZURE_SPEECH_VOICE=en-US-GuyNeural   # default; it has the excited style (without Azure the browser's own voice reads the line)

# Live replay into Azure Event Hubs and Web PubSub.
# The browser uses /api/live directly. replay.py publishes when these are set.
# LIVE_PUBLISH=1 also mirrors tracking frames from the API socket (one publisher is enough).
EVENTHUB_CONNECTION_STRING=
EVENTHUB_NAME=match-events
EVENTHUB_TRACKING_NAME=match-tracking
# EVENTHUB_NAMESPACE=evh-xxx.servicebus.windows.net
# WEBPUBSUB_CONNECTION_STRING=
# WEBPUBSUB_HOST=wps-xxx.webpubsub.azure.com
# WEBPUBSUB_HUB=live
# LIVE_PUBLISH=0
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT=

# Highlight-clip pipeline (off the default synthetic match).
# HIGHLIGHTS_DIR=data/highlights
# HIGHLIGHTS_CONTAINER=highlights
# HIGHLIGHTS_REMOTE_WORKER=0          # 1 = queue only; python -m highlights.worker --watch
# HIGHLIGHT_SECONDS=20
# HIGHLIGHT_FPS=5
# WEBPUBSUB_HIGHLIGHTS_HUB=highlights
# COSMOS_ENDPOINT=
# COSMOS_KEY=
# COSMOS_DATABASE=gamelens
# COSMOS_CONTAINER=highlights

# Admin video workshop (/admin/video). Off on the public fan page.
# ADMIN_VIDEO=1
# ADMIN_TOKEN=choose-a-long-token
# PUBLISHED_DIR=data/published
# VISION_MODEL=yolo11n.pt          # CPU default; yolov8n.pt also works
# VISION_CPU_MODEL=yolo11n.pt
# VISION_GPU_MODEL=yolo11n.pt
# VISION_MAX_WIDTH=960             # frame downsample on CPU
# PITCH_KEYPOINT_MODEL=            # optional 4-point pitch keypoint weights
